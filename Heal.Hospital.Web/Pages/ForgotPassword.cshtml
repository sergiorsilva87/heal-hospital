@page
@model Heal.Hospital.Web.Pages.ForgotPasswordModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L["Recuperar senha"].Value;
}

<!-- Logo -->
<div class="d-flex align-items-center gap-3 mb-4">
    <span class="public-logo-mark">SM</span>
    <div>
        <div class="fw-bold" style="color:var(--txt-primary);font-size:var(--fs-lg)">@L["St. Mungus"]</div>
        <div class="text-muted" style="font-size:var(--fs-xs)">@L["Sistema Hospitalar"]</div>
    </div>
</div>

<h2 class="fw-semibold mb-1" style="font-size:var(--fs-xl)">@L["Recuperar senha"]</h2>
<p class="text-muted mb-4" style="font-size:var(--fs-sm)">
    Informe seu usuário ou e-mail. Se encontrado, enviaremos um link de recuperação.
</p>

@if (Model.Sent)
{
    <div class="alert alert-success d-flex align-items-center gap-2 py-3 mb-4" role="alert">
        <i class="bi bi-envelope-check-fill fs-5"></i>
        <div>
            <strong>Link enviado!</strong><br/>
            <small>Verifique sua caixa de entrada. O link expira em 30 minutos.</small>
        </div>
    </div>
}

@if (!Model.Sent)
{
    <form method="post" asp-antiforgery="true">
        <div class="mb-4">
            <label asp-for="UsernameOrEmail" class="form-label fw-semibold" style="font-size:var(--fs-sm)">
                Usuário ou e-mail
            </label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-person" style="color:var(--txt-muted)"></i></span>
                <input asp-for="UsernameOrEmail" class="form-control" autocomplete="username email" autofocus />
            </div>
            <span asp-validation-for="UsernameOrEmail" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-3">
            <i class="bi bi-send me-2"></i>@L["Enviar link de recuperação"]
        </button>
    </form>
}

<div class="text-center">
    <a asp-page="/Login" class="text-muted" style="font-size:var(--fs-sm)">
        <i class="bi bi-arrow-left me-1"></i>@L["Voltar ao login"]
    </a>
</div>
