@page
@model Heal.Hospital.Web.Pages.Profile.AccountDataModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Dados da conta"].Value;
}

<div class="row g-4 anim-fade-in">
    <div class="col-md-3">@await Html.PartialAsync("_ProfileNav")</div>
    <div class="col-md-9">
        <div class="card p-4">
            <h5 class="fw-semibold mb-4"><i class="bi bi-person-badge me-2" style="color:var(--clr-navy-700)"></i>@L["Dados da conta"]</h5>

            @if (Model.Success) {
                <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-2"></i>@L["Salvo com sucesso."]</div>
            }

            <!-- Read-only info -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label class="form-label fw-semibold" style="font-size:var(--fs-xs)">@L["Usuário"]</label>
                    <input class="form-control" value="@Model.Username" readonly />
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold" style="font-size:var(--fs-xs)">Perfil</label>
                    <input class="form-control" value="@Model.Role" readonly />
                </div>
                <div class="col-sm-6">
                    <label class="form-label fw-semibold" style="font-size:var(--fs-xs)">Nome completo</label>
                    <input class="form-control" value="@Model.FullName" readonly />
                </div>
            </div>
            <hr class="divider" />
            <!-- Editable -->
            <form method="post" asp-antiforgery="true" style="max-width:400px">
                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold" style="font-size:var(--fs-sm)">E-mail de contato</label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy me-1"></i>@L["Salvar"]
                    </button>
                    <a asp-page="/Dashboard/Index" class="btn btn-outline-secondary">@L["Cancelar"]</a>
                </div>
            </form>
        </div>
    </div>
</div>
