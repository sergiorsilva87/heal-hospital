@page
@model Heal.Hospital.Web.Pages.Profile.AccessHistoryModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Histórico de acessos"].Value;
}

<div class="row g-4 anim-fade-in">
    <div class="col-md-3">@await Html.PartialAsync("_ProfileNav")</div>
    <div class="col-md-9">
        <div class="card p-4">
            <h5 class="fw-semibold mb-1"><i class="bi bi-clock-history me-2" style="color:var(--clr-navy-700)"></i>@L["Histórico de acessos"]</h5>
            <p class="text-muted mb-4" style="font-size:var(--fs-sm)">Últimos acessos registrados para sua conta.</p>

            <div class="table-responsive">
                <table class="hosp-table">
                    <thead>
                        <tr>
                            <th>Data / Hora</th>
                            <th>Endereço IP</th>
                            <th>Dispositivo</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.History)
                        {
                            <tr>
                                <td style="white-space:nowrap">@entry.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td><code style="font-size:var(--fs-xs)">@entry.Ip</code></td>
                                <td class="text-muted" style="font-size:var(--fs-xs)">@entry.Device</td>
                                <td>
                                    @if (entry.Success)
                                    {
                                        <span class="badge-status completed">Bem-sucedido</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status urgent">Falhou</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
