@page
@model Heal.Hospital.Web.Pages.Profile.ChangePasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Alterar senha"].Value;
}

<div class="row g-4 anim-fade-in">
    <div class="col-md-3">
        @await Html.PartialAsync("_ProfileNav")
    </div>
    <div class="col-md-9">
        <div class="card p-4">
            <h5 class="fw-semibold mb-4"><i class="bi bi-key me-2" style="color:var(--clr-navy-700)"></i>@L["Alterar senha"]</h5>

            @if (Model.Success)
            {
                <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@L["Salvo com sucesso."]</div>
            }
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <form method="post" asp-antiforgery="true" style="max-width:400px">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:var(--fs-sm)">@L["Senha atual"]</label>
                    <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:var(--fs-sm)">@L["Nova senha"]</label>
                    <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold" style="font-size:var(--fs-sm)">@L["Confirmar nova senha"]</label>
                    <input asp-for="Confirm" type="password" class="form-control" autocomplete="new-password" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy me-1"></i>@L["Salvar"]
                    </button>
                    <a asp-page="/Dashboard/Index" class="btn btn-outline-secondary">@L["Cancelar"]</a>
                </div>
            </form>
        </div>
    </div>
</div>
