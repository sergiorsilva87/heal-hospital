@page
@model Heal.Hospital.Web.Pages.Profile.PersonalDataModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Dados pessoais"].Value;
}

<div class="row g-4 anim-fade-in">
    <div class="col-md-3">@await Html.PartialAsync("_ProfileNav")</div>
    <div class="col-md-9">
        <div class="card p-4">
            <h5 class="fw-semibold mb-4"><i class="bi bi-person-lines-fill me-2" style="color:var(--clr-navy-700)"></i>@L["Dados pessoais"]</h5>

            @if (Model.Success) {
                <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-2"></i>@L["Salvo com sucesso."]</div>
            }

            <form method="post" asp-antiforgery="true" style="max-width:480px">
                <div class="mb-3">
                    <label asp-for="DisplayName" class="form-label fw-semibold" style="font-size:var(--fs-sm)">@L["Nome de exibição"]</label>
                    <input asp-for="DisplayName" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold" style="font-size:var(--fs-sm)">@L["Telefone"]</label>
                    <input asp-for="Phone" class="form-control" type="tel" />
                </div>
                <div class="mb-4">
                    <label asp-for="Department" class="form-label fw-semibold" style="font-size:var(--fs-sm)">@L["Departamento"]</label>
                    <input asp-for="Department" class="form-control" />
                </div>
                @if (Model.ProfRegLabel != null)
                {
                    <div class="mb-4">
                        <label asp-for="ProfRegNumber" class="form-label fw-semibold" style="font-size:var(--fs-sm)">@Model.ProfRegLabel / UF</label>
                        <input asp-for="ProfRegNumber" class="form-control" placeholder="@L["ex: 123456/SP"]" />
                    </div>
                }
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy me-1"></i>@L["Salvar"]
                    </button>
                    <a asp-page="/Dashboard/Index" class="btn btn-outline-secondary">@L["Cancelar"]</a>
                </div>
            </form>
        </div>
    </div>
</div>
