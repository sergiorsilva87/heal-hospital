@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@model Heal.Hospital.Web.Pages.Profile.IndexModel
<div class="prof-card">
    <div class="prof-card-title"><i class="bi bi-key"></i>@L["Alterar senha"]</div>
    @if (Model.PasswordSuccess) {
        <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-2"></i>@L["Salvo com sucesso."]</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
        <div class="alert alert-danger mb-3">@Model.ErrorMessage</div>
    }
    <form method="post" asp-page-handler="password" asp-antiforgery="true">
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label fw-semibold" style="font-size:var(--fs-xs)">@L["Senha atual"]</label>
            <input asp-for="CurrentPassword" type="password" class="form-control form-control-sm" autocomplete="current-password" />
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-semibold" style="font-size:var(--fs-xs)">@L["Nova senha"]</label>
            <input asp-for="NewPassword" type="password" class="form-control form-control-sm" autocomplete="new-password" />
        </div>
        <div class="mb-3">
            <label asp-for="Confirm" class="form-label fw-semibold" style="font-size:var(--fs-xs)">@L["Confirmar nova senha"]</label>
            <input asp-for="Confirm" type="password" class="form-control form-control-sm" autocomplete="new-password" />
        </div>
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-floppy me-1"></i>@L["Salvar"]</button>
    </form>
</div>
