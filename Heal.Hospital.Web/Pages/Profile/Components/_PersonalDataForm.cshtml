@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@model Heal.Hospital.Web.Pages.Profile.IndexModel
<div class="prof-card">
    <div class="prof-card-title"><i class="bi bi-person-lines-fill"></i>@L["Dados pessoais"]</div>
    @if (Model.PersonalDataSuccess) {
        <div class="alert alert-success mb-3"><i class="bi bi-check-circle me-2"></i>@L["Salvo com sucesso."]</div>
    }
    <form method="post" asp-page-handler="personaldata" asp-antiforgery="true">
        <div class="mb-3">
            <label asp-for="DisplayName" class="form-label fw-semibold" style="font-size:var(--fs-xs)">@L["Nome de exibição"]</label>
            <input asp-for="DisplayName" class="form-control form-control-sm" />
        </div>
        <div class="mb-3">
            <label asp-for="Phone" class="form-label fw-semibold" style="font-size:var(--fs-xs)">@L["Telefone"]</label>
            <input asp-for="Phone" type="tel" class="form-control form-control-sm" />
        </div>
        <div class="mb-3">
            <label asp-for="Department" class="form-label fw-semibold" style="font-size:var(--fs-xs)">@L["Departamento"]</label>
            <input asp-for="Department" class="form-control form-control-sm" />
        </div>
        @if (Model.ProfRegLabel != null) {
            <div class="mb-3">
                <label asp-for="ProfRegNumber" class="form-label fw-semibold" style="font-size:var(--fs-xs)">@Model.ProfRegLabel / UF</label>
                <input asp-for="ProfRegNumber" class="form-control form-control-sm" placeholder="@L["ex: 123456/SP"]" />
            </div>
        }
        <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-floppy me-1"></i>@L["Salvar"]</button>
    </form>
</div>
