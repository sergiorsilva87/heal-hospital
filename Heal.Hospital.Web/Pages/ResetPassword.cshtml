@page
@model Heal.Hospital.Web.Pages.ResetPasswordModel
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = L["Redefinir senha"].Value;
}

<!-- Logo -->
<div class="d-flex align-items-center gap-3 mb-4">
    <span class="public-logo-mark">SM</span>
    <div>
        <div class="fw-bold" style="color:var(--txt-primary);font-size:var(--fs-lg)">@L["St. Mungus"]</div>
        <div class="text-muted" style="font-size:var(--fs-xs)">@L["Sistema Hospitalar"]</div>
    </div>
</div>

<h2 class="fw-semibold mb-1" style="font-size:var(--fs-xl)">@L["Redefinir senha"]</h2>
<p class="text-muted mb-4" style="font-size:var(--fs-sm)">Defina sua nova senha abaixo.</p>

@if (Model.Success)
{
    <div class="alert alert-success d-flex align-items-center gap-2 py-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div>@L["Senha redefinida com sucesso."]</div>
    </div>
    <div class="text-center">
        <a asp-page="/Login" class="btn btn-primary">
            <i class="bi bi-box-arrow-in-right me-2"></i>@L["Entrar"]
        </a>
    </div>
}
else if (Model.InvalidToken)
{
    <div class="alert alert-danger d-flex align-items-center gap-2 py-3 mb-4" role="alert">
        <i class="bi bi-exclamation-circle-fill fs-5"></i>
        <div>@L["Token inválido ou expirado."]</div>
    </div>
    <div class="text-center">
        <a asp-page="/ForgotPassword" class="btn btn-outline-primary">@L["Recuperar senha"]</a>
    </div>
}
else
{
    <form method="post" asp-antiforgery="true">
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-semibold" style="font-size:var(--fs-sm)">@L["Nova senha"]</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-lock" style="color:var(--txt-muted)"></i></span>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" autofocus />
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Confirm" class="form-label fw-semibold" style="font-size:var(--fs-sm)">@L["Confirmar nova senha"]</label>
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-lock-fill" style="color:var(--txt-muted)"></i></span>
                <input asp-for="Confirm" type="password" class="form-control" autocomplete="new-password" />
            </div>
            <span asp-validation-for="Confirm" class="text-danger small"></span>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger py-2 mb-3">@Model.ErrorMessage</div>
        }

        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-check-lg me-2"></i>@L["Redefinir senha"]
        </button>
    </form>
}

<div class="text-center mt-3">
    <a asp-page="/Login" class="text-muted" style="font-size:var(--fs-sm)">
        <i class="bi bi-arrow-left me-1"></i>@L["Voltar ao login"]
    </a>
</div>
