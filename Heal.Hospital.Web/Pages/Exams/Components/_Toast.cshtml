@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@* Confirmation toast *@
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index:1090">
    <div id="rx-toast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="rx-toast-body"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="@L["Fechar"]"></button>
        </div>
    </div>
</div>
