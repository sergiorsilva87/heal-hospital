@page
@model Heal.Hospital.Web.Pages.Exams.IndexModel
@using Heal.Hospital.Web.Services
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Lista de Exames"].Value;
    var _loc = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var _tabLoc = _loc.StartsWith("es") ? "es" : _loc.StartsWith("en") ? "en" : "pt-br";
}

@functions {

    // JSON-encoded localized string for safe embedding inside JS. Returns IHtmlContent so Razor
    // does not HTML-encode the quotes; System.Text.Json still escapes <, >, & and non-ASCII.
    Microsoft.AspNetCore.Html.IHtmlContent J(string key) =>
        new Microsoft.AspNetCore.Html.HtmlString(System.Text.Json.JsonSerializer.Serialize(L[key].Value));

}

@* ── Component stylesheets (per-component CSS, loaded via _AuthLayout Styles section) ── *@

@section Styles {
    @if (Model.IsReceptionist)
    {
        <link href="https://unpkg.com/tabulator-tables@6.4.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
        <link rel="stylesheet" href="~/css/exams/flags.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/exams/table.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/exams/filters.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/exams/legend.css" asp-append-version="true"/>
    }
}

<!-- Toolbar -->
<div class="section-header anim-fade-in mb-4">
    <h2 class="section-title">
        <i class="bi bi-file-medical me-2" style="color:var(--clr-navy-700)"></i>
        @L["Lista de Exames"]
        <span class="badge ms-2" style="background:var(--clr-navy-100);color:var(--clr-navy-900);font-size:.75rem;">
            @Model.TotalCount
        </span>
    </h2>
</div>

@if (Model.IsReceptionist)
{
    @* ── Receptionist screen: filters + legend + Tabulator table + modals ── *@
    <partial name="Components/_ExamsFilters"/>
    <partial name="Components/_ExamsLegend"/>
    <partial name="Components/_ExamsTable"/>

    <partial name="Components/_EditPatientModal"/>
    <partial name="Components/_RecoveryModal"/>
    <partial name="Components/_DownloadModal"/>
    <partial name="Components/_CriticalModals"/>
    <partial name="Components/_PendencyModal"/>
    <partial name="Components/_ArchivedModal"/>
    <partial name="Components/_DownloadCodeModal"/>
    <partial name="Components/_DownloadHistoryModal"/>
    <partial name="Components/_Toast"/>
}
else
{
    @* ── Other roles: simple search form + legacy table + server pagination ── *@
    <partial name="Components/_ExamsSearchForm" model="Model"/>
    <partial name="Components/_ExamsLegacyTable" model="Model"/>
    <partial name="Components/_ExamsPagination" model="Model"/>
}

@section Scripts {
    @if (Model.IsReceptionist)
    {
        <script src="https://unpkg.com/tabulator-tables@6.4.0/dist/js/tabulator.min.js"></script>
        @* ── i18n + data bridge: external JS modules read window.Exams.{data,locale} and Exams.t(key) ── *@
        <script>
            (function () {
                var E = window.Exams = window.Exams || {};
                E.data = @Html.Raw(Model.ReceptionExamsJson);
                E.locale = "@_tabLoc";
                E.i18n = {
                    "Processando...": @J("Processando..."),
                    "Processando…": @J("Processando…"),
                    "Nome social:": @J("Nome social:"),
                    "Nasc.:": @J("Nasc.:"),
                    "Idade:": @J("Idade:"),
                    "ID Estudo:": @J("ID Estudo:"),
                    "Data Estudo:": @J("Data Estudo:"),
                    "Liberação:": @J("Liberação:"),
                    "Data Laudo:": @J("Data Laudo:"),
                    "Unidade:": @J("Unidade:"),
                    "Técnico:": @J("Técnico:"),
                    "Executor:": @J("Executor:"),
                    "Solicitante:": @J("Solicitante:"),
                    "ID Paciente": @J("ID Paciente"),
                    "Achado crítico não resolvido": @J("Achado crítico não resolvido"),
                    "Achado crítico resolvido": @J("Achado crítico resolvido"),
                    "Exame com pendências": @J("Exame com pendências"),
                    "doc(s) anexado(s)": @J("doc(s) anexado(s)"),
                    "Sem documentos": @J("Sem documentos"),
                    "Exame arquivado (cold storage)": @J("Exame arquivado (cold storage)"),
                    "Código de download do laudo gerado": @J("Código de download do laudo gerado"),
                    "Laudo já baixado pelo paciente": @J("Laudo já baixado pelo paciente"),
                    "Detalhes": @J("Detalhes"),
                    "Paciente": @J("Paciente"),
                    "Sexo": @J("Sexo"),
                    "Número de Acesso": @J("Número de Acesso"),
                    "Mod.": @J("Mod."),
                    "imagem(ns)": @J("imagem(ns)"),
                    "Procedimento": @J("Procedimento"),
                    "Situação": @J("Situação"),
                    "Tipo": @J("Tipo"),
                    "Ações": @J("Ações"),
                    "Editar dados do paciente": @J("Editar dados do paciente"),
                    "Baixar laudos e anexos": @J("Baixar laudos e anexos"),
                    "Imprimir laudo": @J("Imprimir laudo"),
                    "Todos": @J("Todos"),
                    "aplicado": @J("aplicado"),
                    "aplicados": @J("aplicados"),
                    "Nenhuma alteração registrada.": @J("Nenhuma alteração registrada."),
                    "Arquivo em cold storage — solicitar recuperação": @J("Arquivo em cold storage — solicitar recuperação"),
                    "Recuperar": @J("Recuperar"),
                    "Baixar": @J("Baixar"),
                    "Nenhum laudo disponível.": @J("Nenhum laudo disponível."),
                    "Nenhum arquivo anexado.": @J("Nenhum arquivo anexado."),
                    "Nenhum exame anterior encontrado.": @J("Nenhum exame anterior encontrado."),
                    "Anexo": @J("Anexo"),
                    "Upload": @J("Upload"),
                    "Tamanho": @J("Tamanho"),
                    "Responsável": @J("Responsável"),
                    "Ação": @J("Ação"),
                    "Achado crítico registrado": @J("Achado crítico registrado"),
                    "Achado resolvido": @J("Achado resolvido"),
                    "(sem e-mail cadastrado)": @J("(sem e-mail cadastrado)"),
                    "Contato registrado com sucesso.": @J("Contato registrado com sucesso."),
                    "Achado crítico marcado como resolvido.": @J("Achado crítico marcado como resolvido."),
                    "Resposta enviada para a pendência.": @J("Resposta enviada para a pendência."),
                    "Nenhum item arquivado.": @J("Nenhum item arquivado."),
                    "Restauração solicitada. Você será avisado quando os arquivos estiverem disponíveis (pode levar algumas horas).": @J("Restauração solicitada. Você será avisado quando os arquivos estiverem disponíveis (pode levar algumas horas)."),
                    "Código copiado.": @J("Código copiado."),
                    "O paciente ainda não baixou os laudos.": @J("O paciente ainda não baixou os laudos."),
                    "Recuperação solicitada": @J("Recuperação solicitada")
                };
                E.t = function (k) {
                    var v = E.i18n[k];
                    return v == null ? k : v;
                };
            })();
        </script>
        @* ── Component modules (deterministic load order: core → table → filters → modals) ── *@
        <script src="~/js/exams/core.js" asp-append-version="true"></script>
        <script src="~/js/exams/table.js" asp-append-version="true"></script>
        <script src="~/js/exams/filters.js" asp-append-version="true"></script>
        <script src="~/js/exams/edit-patient-modal.js" asp-append-version="true"></script>
        <script src="~/js/exams/download-modal.js" asp-append-version="true"></script>
        <script src="~/js/exams/recovery-modal.js" asp-append-version="true"></script>
        <script src="~/js/exams/critical-modals.js" asp-append-version="true"></script>
        <script src="~/js/exams/pendency-modal.js" asp-append-version="true"></script>
        <script src="~/js/exams/archived-modal.js" asp-append-version="true"></script>
        <script src="~/js/exams/download-code-modal.js" asp-append-version="true"></script>
        <script src="~/js/exams/download-history-modal.js" asp-append-version="true"></script>
    }
}
