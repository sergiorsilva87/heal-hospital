@page
@model Heal.Hospital.Web.Pages.Exams.IndexModel
@using Heal.Hospital.Web.Services
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Lista de Exames"].Value;
}

@functions {
    string PageLink(int page) =>
        Url.Page(null, new { Search = Model.Search, StatusFilter = Model.StatusFilter, page })!;
}

<!-- Toolbar -->
<div class="section-header anim-fade-in mb-4">
    <h2 class="section-title">
        <i class="bi bi-file-medical me-2" style="color:var(--clr-navy-700)"></i>
        @L["Lista de Exames"]
        <span class="badge ms-2" style="background:var(--clr-navy-100);color:var(--clr-navy-900);font-size:.75rem;">
            @Model.TotalCount
        </span>
    </h2>
</div>

<!-- Filters -->
<form method="get" class="card p-3 mb-4 anim-fade-in anim-delay-1">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label fw-semibold" style="font-size:var(--fs-xs)">@L["Buscar"]</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input name="Search" value="@Model.Search" class="form-control"
                       placeholder="@(Model.IsReceptionist ? "Paciente, nome social, CPF, ID..." : "Paciente ou nº do exame…")" />
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold" style="font-size:var(--fs-xs)">@L["Status"]</label>
            <select name="StatusFilter" class="form-select form-select-sm">
                <option value="">@L["Todos"]</option>
                @if (Model.IsReceptionist)
                {
                    @foreach (var st in Enum.GetValues<MockData.ExamReportStatus>()
                                        .Where(s => s != MockData.ExamReportStatus.AwaitingSignature))
                    {
                        <option value="@st" selected="@(Model.StatusFilter == st.ToString())">
                            @MockData.GetReceptionStatusLabel(st)
                        </option>
                    }
                }
                else
                {
                    @foreach (var s in new[] { "Agendado", "Em andamento", "Concluído", "Laudo pendente", "Laudo emitido" })
                    {
                        <option value="@s" selected="@(Model.StatusFilter == s)">@s</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary btn-sm w-100">
                <i class="bi bi-funnel me-1"></i>@L["Filtrar"]
            </button>
        </div>
    </div>
</form>

@* ─────────────────────────────────────────────────────────
   RECEPTIONIST — Tabulator nested-tree table
   ───────────────────────────────────────────────────────── *@
@if (Model.IsReceptionist)
{
    var _loc = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var _tabLoc = _loc.StartsWith("es") ? "es" : _loc.StartsWith("en") ? "en" : "pt-br";

    <link href="https://unpkg.com/tabulator-tables@6.4.0/dist/css/tabulator_bootstrap5.min.css" rel="stylesheet">
    <style>
        #reception-table .tabulator-col-title  { font-size: .79rem; font-weight: 600; }
        #reception-table .tabulator-cell       { font-size: .8rem; }
        /* emergency row highlight */
        #reception-table .tabulator-row.row-emergency { background-color: #fff5f5 !important; }
        #reception-table .tabulator-row.row-emergency .tabulator-cell { color: #7f1d1d; }
        /* Ações cell must not clip buttons */
        #reception-table .tabulator-cell { overflow: visible; }
        /* normalize code elements — same face as surrounding text */
        #reception-table .tabulator-cell code { font-family: inherit; font-weight: 600; }
        /* uniform row font weight */
        #reception-table .tabulator-cell { font-weight: 400; }
        /* flex-wrap on rows allows inline detail panel below cells */
        #reception-table .tabulator-row { flex-wrap: wrap !important; }
        #reception-table .rx-detail { flex: 0 0 100%; width: 100%; display: none; flex-wrap: wrap; }
        #reception-table .rx-detail.open { display: flex; }
        #reception-table .rx-detail-row {
            flex: 0 0 100%; width: 100%;
            display: flex; flex-wrap: wrap; align-items: center;
            gap: 0 1.5rem; padding: 4px 12px 4px 40px;
            font-size: .75rem; color: var(--clr-navy-800); background: #f0f4fa;
        }
        #reception-table .rx-detail-row + .rx-detail-row { border-top: 1px dashed #d0d7e2; }
        #reception-table .rx-detail b { font-weight: 600; }
        /* expand toggle chevron */
        #reception-table .rx-toggle-icon {
            display: inline-block; margin-right: 8px; cursor: pointer;
            font-size: .85rem; color: var(--clr-navy-600); transition: transform .15s;
        }
        #reception-table .row-open .rx-toggle-icon { transform: rotate(90deg); }
        /* pagination: compact size */
        #reception-table .tabulator-footer { font-size: .78rem; }
        #reception-table .tabulator-footer .tabulator-paginator label { font-size: .78rem; }
        #reception-table .tabulator-footer .tabulator-page-size { font-size: .78rem; padding: 1px 4px; height: auto; }
        #reception-table .tabulator-footer .tabulator-page { padding: 2px 8px; font-size: .78rem; line-height: 1.4; }
        /* flag icons: critical finding + pendency */
        .rx-flags-slot {
            display: inline-flex; align-items: center; gap: 3px;
            width: 2.6rem; min-width: 2.6rem;
            vertical-align: middle; margin-right: 2px;
        }
        .rx-flag-critical-unnotified { color: #c62828; font-size: .95rem; cursor: default; }
        .rx-flag-critical-notified   { color: #2e7d32; font-size: .95rem; cursor: default; }
        .rx-flag-pendency            { color: #e65100; font-size: .95rem; cursor: default; }
        #reception-table .tabulator-cell .rx-flags { display: inline-flex; gap: 5px; align-items: center; }
        /* external loading overlay */
        #rx-loading-overlay {
            position: absolute; inset: 0; z-index: 10;
            background: rgba(255,255,255,.88);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: .6rem;
            font-size: .83rem; font-weight: 500; color: var(--clr-navy-700);
        }
        #rx-loading-overlay.rx-op {
            flex-direction: row; justify-content: flex-start;
            padding: .5rem .75rem; inset: auto 0 0 0;
            height: 2.4rem; background: rgba(240,244,250,.95);
            border-top: 1px solid #d0d7e2; font-size: .8rem; font-weight: 400;
        }
        #rx-loading-overlay.hidden { display: none; }
        /* block column resize handles */
        #reception-table .tabulator-col-resize-handle { display: none !important; pointer-events: none !important; }
        /* legend: distinct color per status group */
        #reception-legend .badge-status.scheduled   { background: #e3f2fd; color: #0d47a1; }
        #reception-legend .badge-status.in-progress { background: #fff3e0; color: #bf360c; }
        #reception-legend .badge-status.pending     { background: #f3e5f5; color: #6a1b9a; }
        #reception-legend .badge-status.issued      { background: #e8f5e9; color: #1b5e20; }
        #reception-legend .badge-status.cancelled   { background: #f0f0f0; color: #6c757d; }
    </style>

    @* Status legend *@
    <div id="reception-legend" class="d-flex flex-wrap gap-2 align-items-center mb-2" style="font-size:.72rem">
        <span class="text-muted fw-semibold me-1">Legenda:</span>
        <span class="badge-status scheduled">Ag. Liberação</span>
        <span class="badge-status scheduled">Na Fila (Disponível)</span>
        <span class="badge-status in-progress">Laudando</span>
        <span class="badge-status pending">Pendência</span>
        <span class="badge-status pending">Revisão Solicitada</span>
        <span class="badge-status issued">Aprovado</span>
        <span class="badge-status issued">Aprovado c/ Revisão</span>
        <span class="badge-status cancelled">Cancelado</span>
    </div>

    <div class="card anim-fade-in anim-delay-2 p-2">
        <div id="reception-table-wrap" style="overflow-x:auto;position:relative">
            <div id="reception-table"></div>
            <div id="rx-loading-overlay">
                <div class="spinner-border" role="status" style="width:2.25rem;height:2.25rem;color:var(--clr-navy-600)">
                    <span class="visually-hidden">Carregando...</span>
                </div>
                <span>Carregando dados do servidor&hellip;</span>
            </div>
        </div>
    </div>

    @* Edit patient modal *@
    <div class="modal fade" id="editPatientModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-pencil-square me-2"></i>Editar dados do paciente
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form method="post" asp-antiforgery="true">
                    <div class="modal-body">
                        <p class="text-muted mb-3" style="font-size:var(--fs-xs)">
                            <i class="bi bi-info-circle me-1"></i>
                            Alterações são propagadas para os dados do paciente, tags DICOM e cabeçalho do laudo.
                        </p>
                        <input type="hidden" id="ep-patient-id" name="PatientId" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nome completo</label>
                                <input type="text" id="ep-name" name="PatientName" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nome social</label>
                                <input type="text" id="ep-social" name="SocialName" class="form-control" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Sexo</label>
                                <select id="ep-sex" name="Sex" class="form-select">
                                    <option value="M">M</option>
                                    <option value="F">F</option>
                                    <option value="O">Outro</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Nascimento (data/hora)</label>
                                <input type="datetime-local" step="1" id="ep-birth" name="BirthDateTime" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">CPF</label>
                                <input type="text" id="ep-cpf" name="Cpf" class="form-control" placeholder="000.000.000-00" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">E-mail</label>
                                <input type="email" id="ep-email" name="Email" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Código de download do laudo</label>
                                <div class="input-group">
                                    <input type="text" id="ep-access-code" name="DownloadAccessCode"
                                           class="form-control" maxlength="6" readonly />
                                    <button type="button" id="ep-gen-code" class="btn btn-outline-primary"
                                            title="Gerar novo código de 6 dígitos">
                                        <i class="bi bi-key"></i> Gerar
                                    </button>
                                </div>
                                <div class="form-text" style="font-size:var(--fs-xs)">
                                    Código de 6 dígitos para o paciente baixar o laudo no portal.
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2 me-1"></i>Salvar alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://unpkg.com/tabulator-tables@6.4.0/dist/js/tabulator.min.js"></script>
        <script>
            (function () {
                var tableData = @Html.Raw(Model.ReceptionExamsJson);

                /* HTML-escape helper for formatter output */
                function escH(s) {
                    return String(s == null ? '' : s)
                        .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                }

                /* ── Modality abbreviation & badge colors (non-retired DICOM codes) ── */
                var _modAbbr = {
                    'Radiografia': 'DX', 'Tomografia': 'CT', 'Ressonância': 'MR',
                    'Ultrassonografia': 'US', 'Mamografia': 'MG', 'PET-CT': 'PT',
                    'Fluoroscopia': 'RF', 'Cintilografia': 'NM', 'Angiografia': 'XA',
                    'Densitometria': 'BDUS', 'Eletrocardiograma': 'ECG'
                };
                var _modClr = {
                    CT:   { bg: '#fff3e0', c: '#bf360c' },
                    MR:   { bg: '#f3e5f5', c: '#6a1b9a' },
                    US:   { bg: '#e0f7fa', c: '#006064' },
                    MG:   { bg: '#fce4ec', c: '#880e4f' },
                    PT:   { bg: '#e8f5e9', c: '#1b5e20' },
                    DX:   { bg: '#e3f2fd', c: '#0d47a1' },
                    CR:   { bg: '#e8eaf6', c: '#1a237e' },
                    NM:   { bg: '#f9fbe7', c: '#33691e' },
                    RF:   { bg: '#e0f2f1', c: '#004d40' },
                    XA:   { bg: '#fbe9e7', c: '#b71c1c' },
                    ECG:  { bg: '#fff8e1', c: '#e65100' },
                    BDUS: { bg: '#f1f8e9', c: '#558b2f' }
                };

                /* ── Status dot colors (must match #reception-legend CSS) ── */
                var _statusDotClr = {
                    'scheduled':   '#0d47a1',
                    'in-progress': '#bf360c',
                    'pending':     '#6a1b9a',
                    'issued':      '#1b5e20',
                    'urgent':      '#b71c1c',
                    'cancelled':   '#9e9e9e'
                };

                /* ── Loading overlay (external div, immune to Tabulator lifecycle) ── */
                var _overlay = document.getElementById('rx-loading-overlay');
                var _spinnerSmHtml =
                    '<div class="spinner-border spinner-border-sm" role="status" style="color:var(--clr-navy-600)">'
                    + '<span class="visually-hidden">Processando...</span></div>'
                    + '<span>Processando…</span>';

                var _initialLoading = true;
                var _opTimer = null;

                function _showOpOverlay() {
                    if (_initialLoading) return;
                    if (_opTimer) { clearTimeout(_opTimer); _opTimer = null; }
                    _overlay.innerHTML = _spinnerSmHtml;
                    _overlay.classList.add('rx-op');
                    _overlay.classList.remove('hidden');
                }
                function _hideOpOverlay() {
                    if (_initialLoading) return;
                    if (_opTimer) clearTimeout(_opTimer);
                    _opTimer = setTimeout(function () {
                        _overlay.classList.add('hidden');
                        _opTimer = null;
                    }, 120);
                }

                var table = new Tabulator("#reception-table", {
                    data: [],
                    layout: "fitColumns",
                    resizableColumns: false,
                    rowFormatter: function (row) {
                        var d  = row.getData();
                        var el = row.getElement();
                        if (d.isEmergency) el.classList.add('row-emergency');
                        if (el.querySelector('.rx-detail')) return;

                        var detail = document.createElement('div');
                        detail.className = 'rx-detail';

                        var r1 = '<div class="rx-detail-row">';
                        if (d.socialNameRaw) r1 += '<span><b>Nome social:</b> ' + escH(d.socialNameRaw) + '</span>';
                        r1 += '<span><b>Nasc.:</b> '      + escH(d.birthStr)          + '</span>';
                        r1 += '<span><b>Idade:</b> '       + escH(d.ageFormatted)      + '</span>';
                        r1 += '<span><b>ID Estudo:</b> '   + escH(d.studyId)           + '</span>';
                        r1 += '<span><b>Data Estudo:</b> '   + escH(d.studyDateTime)     + '</span>';
                        r1 += '<span><b>Liberação:</b> '        + escH(d.liberationDateStr) + '</span>';
                        r1 += '<span><b>Data Laudo:</b> '    + escH(d.reportDateTimeStr) + '</span>';
                        r1 += '</div>';

                        var r2 = '<div class="rx-detail-row">';
                        r2 += '<span><b>Unidade:</b> '     + escH(d.unit)               + '</span>';
                        r2 += '<span><b>T\u00e9cnico:</b> '   + escH(d.technicianName)     + '</span>';
                        r2 += '<span><b>Executor:</b> '    + escH(d.executingPhysician)  + '</span>';
                        r2 += '<span><b>Solicitante:</b> ' + escH(d.requestingPhysician) + '</span>';
                        r2 += '</div>';

                        detail.innerHTML = r1 + r2;
                        el.appendChild(detail);
                    },
                    pagination: true,
                    paginationMode: "local",
                    paginationSize: 10,
                    paginationSizeSelector: [10, 15, 25, 50],
                    locale: "@_tabLoc",
                    langs: {
                        "pt-br": {
                            pagination: {
                                page_size: "Itens por página",
                                first: "Primeira", first_title: "Primeira página",
                                last: "Última",    last_title: "Última página",
                                prev: "Anterior",  prev_title: "Página anterior",
                                next: "Próxima",   next_title: "Próxima página",
                                all: "Todos",
                                counter: { showing: "Exibindo", of: "de", rows: "registros", pages: "páginas" }
                            }
                        },
                        "en": {
                            pagination: {
                                page_size: "Page size:",
                                first: "First", first_title: "First Page",
                                last: "Last",   last_title: "Last Page",
                                prev: "Prev",   prev_title: "Previous Page",
                                next: "Next",   next_title: "Next Page",
                                all: "All",
                                counter: { showing: "Showing", of: "of", rows: "rows", pages: "pages" }
                            }
                        },
                        "es": {
                            pagination: {
                                page_size: "Por pág.:",
                                first: "Primera",   first_title: "Primera página",
                                last: "Última",     last_title: "Última página",
                                prev: "Anterior",   prev_title: "Página anterior",
                                next: "Siguiente",  next_title: "Página siguiente",
                                all: "Todos",
                                counter: { showing: "Mostrando", of: "de", rows: "registros", pages: "páginas" }
                            }
                        }
                    },
                    columns: [
                        /* ── Col 1: ID Paciente ─────────────────────────────── */
                        {
                            title: "ID Paciente", field: "patientId", widthGrow: 1, minWidth: 130,
                            formatter: function (cell) {
                                var d = cell.getRow().getData();
                                var flags = '';
                                if (d.criticalFinding === 'unnotified')
                                    flags += '<i class="bi bi-exclamation-triangle-fill rx-flag-critical-unnotified" title="Achado crítico não resolvido"></i>';
                                else if (d.criticalFinding === 'notified')
                                    flags += '<i class="bi bi-patch-check-fill rx-flag-critical-notified" title="Achado crítico resolvido"></i>';
                                if (d.hasPendency)
                                    flags += '<i class="bi bi-paperclip rx-flag-pendency" title="Exame com pendências"></i>';
                                return '<span class="rx-flags-slot">' + flags + '</span>'
                                     + '<i class="bi bi-chevron-right rx-toggle-icon" title="Detalhes"></i>'
                                     + '<code style="color:var(--clr-navy-700)">' + escH(d.patientId) + '</code>';
                            },
                            cellClick: function (e, cell) {
                                var rowEl  = cell.getRow().getElement();
                                var detail = rowEl.querySelector('.rx-detail');
                                if (!detail) return;
                                var isOpen = detail.classList.toggle('open');
                                rowEl.classList.toggle('row-open', isOpen);
                            }
                        },
                        /* ── Col 2: Paciente (pai) | child: handled by rowFormatter */
                        {
                            title: "Paciente", field: "patientName", widthGrow: 2, minWidth: 140,
                            formatter: function (cell) {
                                var d = cell.getRow().getData();
                                if (d._isChild) return '';
                                return escH(d.patientName);
                            }
                        },
                        /* ── Col 3: Gênero (pai) | vazio (filho) ────────────── */
                        {
                            title: "Gênero", field: "sexRaw", width: 72, hozAlign: "center",
                            formatter: function (cell) {
                                var d = cell.getRow().getData();
                                if (d._isChild) return '';
                                return escH(d.sexRaw);
                            }
                        },
                        /* ── Col 4: AN = Nº Acesso (pai) | vazio (filho) ───────── */
                        {
                            title: "AN", field: "accessCodeRaw", width: 82, headerTooltip: "Número de Acesso",
                            formatter: function (cell) {
                                var d = cell.getRow().getData();
                                if (d._isChild) return '';
                                return '<code style="color:var(--clr-navy-700)">' + escH(d.accessCodeRaw) + '</code>';
                            }
                        },
                        /* ── Col 5: Mod. (pai) | child: handled by rowFormatter */
                        {
                            title: "Mod.", field: "modality", width: 82,
                            formatter: function (cell) {
                                var d = cell.getRow().getData();
                                if (d._isChild) return '';
                                var abbr = _modAbbr[d.modality] || d.modality;
                                var clr  = _modClr[abbr] || { bg: '#f0f0f0', c: '#444' };
                                return '<span style="display:inline-block;padding:1px 9px;border-radius:20px;font-weight:600;white-space:nowrap;background:' + clr.bg + ';color:' + clr.c + '">' + escH(abbr) + '</span>';
                            }
                        },
                        /* ── Col 6: Procedimento (pai) | child: handled by rowFormatter */
                        {
                            title: "Procedimento", field: "procedure", widthGrow: 2, minWidth: 155,
                            formatter: function (cell) {
                                var d = cell.getRow().getData();
                                if (d._isChild) return '';
                                return escH(d.procedure);
                            }
                        },
                        /* ── Col 7: Situação (pai) | child: handled by rowFormatter */
                        {
                            title: "Situação", field: "statusLabel", widthGrow: 1, minWidth: 80,
                            formatter: function (cell) {
                                var d = cell.getRow().getData();
                                if (d._isChild) return '';
                                var clr = _statusDotClr[d.statusCss] || '#666';
                                return '<span style="display:inline-block;width:14px;height:14px;border-radius:50%;background:' + clr + ';vertical-align:middle;cursor:default" title="' + escH(d.statusLabel) + '"></span>';
                            }
                        },
                        /* ── Col 8: Tipo (pai) | child: handled by rowFormatter */
                        {
                            title: "Tipo", field: "typeLabel", widthGrow: 1, minWidth: 92,
                            formatter: function (cell) {
                                var d = cell.getRow().getData();
                                if (d._isChild) return '';
                                return '<span class="badge" style="background:var(--clr-navy-100);color:var(--clr-navy-900)">' + escH(d.typeLabel) + '</span>';
                            }
                        },
                        /* ── Col: Ações ───────────────────────────────── */
                        {
                            title: "Ações", field: "hasReport", width: 140, hozAlign: "right",
                            headerSort: false,
                            formatter: function (cell) {
                                var d = cell.getRow().getData();
                                if (d._isChild) return '';
                                var html = '<div class="d-flex gap-1 justify-content-end">';
                                html += '<button class="btn btn-sm btn-outline-primary btn-edit-patient py-0"'
                                      + ' data-id="'     + escH(d.patientId)     + '"'
                                      + ' data-name="'   + escH(d.patientName)   + '"'
                                      + ' data-social="' + escH(d.socialNameRaw) + '"'
                                      + ' data-sex="'    + escH(d.sexRaw)        + '"'
                                      + ' data-birth="'  + escH(d.birthForInput) + '"'
                                      + ' data-cpf="'    + escH(d.cpfRaw)        + '"'
                                      + ' data-email="'  + escH(d.emailRaw)      + '"'
                                      + ' data-code="'   + escH(d.accessCodeRaw) + '"'
                                      + ' title="Editar dados do paciente">'
                                      + '<i class="bi bi-pencil-square"></i></button>';
                                if (d.hasReport) {
                                    html += '<a href="#" class="btn btn-sm btn-outline-primary py-0" title="Baixar laudo (PDF)"><i class="bi bi-download"></i></a>';
                                    html += '<a href="#" class="btn btn-sm btn-outline-primary py-0" title="Imprimir laudo" target="_blank"><i class="bi bi-printer"></i></a>';
                                }
                                html += '</div>';
                                return html;
                            }
                        }
                    ]
                });

                /* ── Initial load: overlay visible until data renders ── */
                setTimeout(function () {
                    table.setData(tableData).then(function () {
                        _initialLoading = false;
                        _overlay.classList.add('hidden');
                    });
                }, 3000 + Math.floor(Math.random() * 2001));

                /* ── Brief loader on sort, filter and page change ────── */
                table.on('dataSorting',   _showOpOverlay);
                table.on('dataSorted',    _hideOpOverlay);
                table.on('dataFiltering', _showOpOverlay);
                table.on('dataFiltered',  _hideOpOverlay);
                table.on('pageLoading',   _showOpOverlay);
                table.on('pageLoaded',    _hideOpOverlay);

                /* ── Edit modal — delegated click on table wrapper ── */
                document.getElementById('reception-table-wrap').addEventListener('click', function (e) {
                    var btn = e.target.closest('.btn-edit-patient');
                    if (!btn) return;
                    var modal = document.getElementById('editPatientModal');
                    modal.querySelector('#ep-patient-id').value  = btn.dataset.id     || '';
                    modal.querySelector('#ep-name').value        = btn.dataset.name   || '';
                    modal.querySelector('#ep-social').value      = btn.dataset.social || '';
                    modal.querySelector('#ep-sex').value         = btn.dataset.sex    || 'M';
                    modal.querySelector('#ep-birth').value       = btn.dataset.birth  || '';
                    modal.querySelector('#ep-cpf').value         = btn.dataset.cpf    || '';
                    modal.querySelector('#ep-email').value       = btn.dataset.email  || '';
                    modal.querySelector('#ep-access-code').value = btn.dataset.code   || '';
                    bootstrap.Modal.getOrCreateInstance(modal).show();
                });

                document.getElementById('ep-gen-code').addEventListener('click', function () {
                    document.getElementById('ep-access-code').value =
                        Math.floor(100000 + Math.random() * 900000).toString();
                });
            })();
        </script>
    }
}
@* ─────────────────────────────────────────────────────────
   OTHER ROLES — Simple legacy table
   ───────────────────────────────────────────────────────── *@
else
{
    <div class="card anim-fade-in anim-delay-2">
        @if (Model.FilteredExams.Length == 0)
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox" style="font-size:3rem;opacity:.4"></i>
                <p class="mt-3 mb-0">@L["Nenhum exame encontrado."]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="hosp-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>@L["Paciente"]</th>
                            <th>@L["Modalidade"]</th>
                            <th>Médico</th>
                            <th>@L["Data"]</th>
                            <th>@L["Status"]</th>
                            <th>@L["Ações"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var exam in Model.FilteredExams)
                        {
                            var statusCss = exam.Status switch {
                                "Agendado"       => "scheduled",
                                "Em andamento"   => "in-progress",
                                "Concluído"      => "completed",
                                "Laudo pendente" => "pending",
                                "Laudo emitido"  => "issued",
                                _                => "completed"
                            };
                            <tr>
                                <td><code style="font-size:var(--fs-xs);color:var(--clr-navy-700)">@exam.Id</code></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="hosp-avatar" style="width:28px;height:28px;font-size:.65rem;">
                                            @string.Join("", exam.Patient.Split(' ').Take(2).Select(p => p[0]))
                                        </span>
                                        @exam.Patient
                                    </div>
                                </td>
                                <td>@exam.Modality</td>
                                <td class="text-muted" style="font-size:var(--fs-xs)">@exam.Physician</td>
                                <td style="white-space:nowrap">@exam.Date.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge-status @statusCss">@exam.Status</span></td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-secondary" title="Ver detalhes">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        @if (exam.ReportUrl is not null)
                                        {
                                            <a href="@exam.ReportUrl" class="btn btn-sm btn-outline-primary" title="Ver laudo">
                                                <i class="bi bi-file-earmark-text"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3 anim-fade-in anim-delay-3" aria-label="Paginação de exames">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item @(Model.PageIndex == 1 ? "disabled" : "")">
                    <a class="page-link" href="@PageLink(Math.Max(1, Model.PageIndex - 1))"><i class="bi bi-chevron-left"></i></a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                        <a class="page-link" href="@PageLink(p)">@p</a>
                    </li>
                }
                <li class="page-item @(Model.PageIndex == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@PageLink(Math.Min(Model.TotalPages, Model.PageIndex + 1))"><i class="bi bi-chevron-right"></i></a>
                </li>
            </ul>
            <p class="text-center text-muted mt-2 mb-0" style="font-size:var(--fs-xs)">
                Página @Model.PageIndex de @Model.TotalPages · @Model.TotalCount exames
            </p>
        </nav>
    }
}
